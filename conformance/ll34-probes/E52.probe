# Configure the ll-34 logic analyzer for the E52 capture (trap
# priority encoder). Its output must match the capture from the real
# hardware in ../captures/traps.

add K2:E52:5, K2:E52:6, K2:E52:7, K2:E52:4, K2:E52:3
add K2:E52:2, K2:E52:1, K2:E52:17, K2:E52:16, K2:E52:15
add K2:E52:14, K2:E52:13, K2:E52:12, K2:E52:11
add K2:E52:8
depth 262144
pos 0
rate 1
arm
export conformance/build/ll34-E52.sr 50
exit
