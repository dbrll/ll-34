# Configure the ll-34 logic analyzer for the E53 capture (trap decode
# of the instruction, IR CODE and HALT). Its output must match the capture
# from the real hardware in ../captures/traps.

add K2:E53:5, K2:E53:6, K2:E53:7, K2:E53:4, K2:E53:3, K2:E53:2
add K2-6 IR CODE 02 L, K2-6 IR CODE 01 L, K2-6 IR CODE 00 L
add K2:E53:15, K2:E53:1, K2-6 HALT RQST L
add K2:E53:13, K2:E53:14, K2:E52:8
depth 262144
pos 0
rate 1
arm
export conformance/build/ll34-E53.sr 50
exit
