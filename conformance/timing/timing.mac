        .word 012737,000300,000102 ; MOV #192,@#66
        .word 012737,000100,177546 ; MOV #64,@#65382
        .word 012737,000000,177776 ; MOV #0,@#65534
        .word 004737,001742 ; JSR PC,@#SYNC
        .word 012704,111526 ; MOV #HEADER,R/spec 4
        .word 004737,002062 ; JSR PC,@#PUTS
        .word 012705,110660 ; MOV #TABLE,R/spec 5
NEXT:
        .word 012504 ; MOV (R5)+,R4
        .word 001002 ; branch HAVE
        .word 000137,001616 ; JMP @#FINISH
HAVE:
        .word 004737,002062 ; JSR PC,@#PUTS
        .word 012537,000504,012537,000506 ; load test and matching baseline functions
        .word 012737,000400,000502 ; MOV #256,@#N
CAL:
        .word 013700,000504 ; MOV @#FN,R0
        .word 004737,002012 ; JSR PC,@#MEASURE
        .word 010037,000512 ; MOV R0,@#RAW
        .word 020027,000144 ; CMP R0,#100 decimal ticks
        .word 103020 ; branch READY
        .word 013700,000502 ; MOV @#N,R0
        .word 020027,077777
        .word 001413 ; branch READY
        .word 006300 ; ASL R0
        .word 100404 ; branch CAP
        .word 010037,000502 ; MOV R0,@#N
        .word 000137,001166 ; JMP @#CAL
CAP:
        .word 012737,077777,000502 ; MOV #32767,@#N
        .word 000137,001166 ; JMP @#CAL
READY:
        .word 013700,000506 ; MOV @#BASEFN,R0
        .word 004737,002012 ; JSR PC,@#MEASURE
        .word 010037,000514 ; MOV R0,@#BASE
        .word 013700,000512 ; MOV @#RAW,R0
        .word 163700,000514 ; SUB @#BASE,R0
        .word 010037,000516 ; MOV R0,@#NET
        .word 020027,000144
        .word 103031 ; branch RECORD
        .word 013700,000502 ; MOV @#N,R0
        .word 020027,077777
        .word 001424 ; branch RECORD
        .word 013700,000516 ; MOV @#NET,R0
        .word 005700
        .word 001413 ; branch REFCAP
        .word 013700,000502 ; MOV @#N,R0
        .word 070027,000156,071037,000516 ; new N = old N * 110 / net ticks
        .word 102404 ; branch REFCAP
        .word 010037,000502 ; MOV R0,@#N
        .word 000137,001166 ; JMP @#CAL
REFCAP:
        .word 012737,077777,000502 ; MOV #32767,@#N
        .word 000137,001166 ; JMP @#CAL
