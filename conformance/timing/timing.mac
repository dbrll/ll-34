        .word 005237,000500 ; INC @#TICKS
        .word 012737,000100,177546 ; MOV #64,@#65382
        .word 000002 ; RTI, registers unchanged
SYNC:
        .word 010046,010146,010246
        .word 013700,000500 ; MOV @#TICKS,R0
        .word 012702,000010 ; MOV #8,R/spec 2
WAITOUT:
        .word 012701,000000 ; MOV #0,R/spec 1
WAITCLK:
        .word 023700,000500 ; CMP @#TICKS,R0
