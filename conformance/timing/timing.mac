        .word 012737,000000,177546 ; MOV #0,@#65382
        .word 012737,000340,177776 ; MOV #224,@#65534
        .word 012737,000001,000526 ; MOV #1,@#STATUS
        .word 012704,111660 ; MOV #ENDMSG,R/spec 4
        .word 004737,002062 ; JSR PC,@#PUTS
        .word 000000 ; HALT success
