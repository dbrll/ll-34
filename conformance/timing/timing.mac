; TIMING: Times 70 instruction classes with the 50Hz line clock,
; and prints the results in decimal.
; Each instruction is repeated 64 times for a meaningful result.
;
; Starts at 1000.
        .asect
.=4
        .word 001652,000340 ; fatal trap vector
.=10
        .word 001652,000340 ; fatal trap vector
.=100
        .word 001726,000300 ; line clock BR6, vector 100
.=500
TICKS:
        .word 000000
N:
        .word 000000
FN:
        .word 000000
BASEFN:
        .word 000000
T0:
        .word 000000
RAW:
        .word 000000
BASE:
        .word 000000
NET:
        .word 000000
PTR:
        .word 000000
RESULT:
        .word 000000
DONE:
        .word 000000
STATUS:
        .word 000000
.=1000
START:
