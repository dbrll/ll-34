        .word 011637,000560 ; save fault PC for diagnostics
        .word 012737,000003,000526 ; MOV #3,@#STATUS
        .word 012706,157000 ; MOV #56832,R/spec 6
        .word 012704,112024 ; MOV #FAULTMSG,R/spec 4
        .word 000137,001712 ; JMP @#ABORT
